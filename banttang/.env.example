# ============================================================
# 반띵 환경 변수 예시
# 실제 값은 .env.local 등에 저장하고 절대 커밋하지 말 것
# ============================================================

# ---------- Supabase ----------
# 2024년 말부터 anon / service_role JWT는 레거시. 신규 키(sb_publishable_..., sb_secret_...) 사용.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...   # FastAPI 전용, 절대 클라이언트 노출 금지

# ---------- 카카오 ----------
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-js-key
KAKAO_REST_API_KEY=your-kakao-rest-key

# ---------- FastAPI ----------
FASTAPI_BASE_URL=http://localhost:8000
# 클라이언트에서 호출할 경우 노출되는 base URL (Next.js public env)
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_TOKEN=replace-with-strong-random-string

# ---------- Claude / Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- 네이버 검색 API (추천 피드 데이터 소스) ----------
# https://developers.naver.com → 애플리케이션 등록 → 검색 API 사용 설정.
# 일일 호출 한도 25,000회 — 동네별 캐시로 호출 수 절감.
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ---------- 추천 캐시 갱신 cron (pg_cron → /api/internal/refresh-feeds) ----------
# 강한 랜덤 문자열. Supabase Vault 의 cron_secret 과 동일 값으로 맞출 것.
CRON_SECRET=replace-with-strong-random-string

# ---------- 네이버 CLOVA OCR ----------
CLOVA_OCR_SECRET=your-clova-secret
CLOVA_OCR_INVOKE_URL=https://...

# ---------- 카카오 알림톡 (비즈뿌리오 / 알리고) ----------
ALIMTALK_API_KEY=
ALIMTALK_SENDER_KEY=

# ---------- 결제 PG ----------
TOSS_SECRET_KEY=
PORTONE_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Prisma (영수증 인증 — receipt_redemptions) ----------
# Supabase Dashboard → Project Settings → Database → Connection string에서 복사.
# 두 개 모두 필요: pooled(런타임) + direct(migrate dev/migrations).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ---------- Upstash (영수증 인증 rate limit) ----------
# https://console.upstash.com → Redis DB → REST URL/Token 복사.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ---------- Slack (영수증 추출 신뢰도 < 0.6 알림) ----------
# Slack App → Incoming Webhooks → 채널별 Webhook URL 생성.
SLACK_WEBHOOK_URL=

# ---------- 본인인증 (PASS / NICE) ----------
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=

# ---------- 관측 ----------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
