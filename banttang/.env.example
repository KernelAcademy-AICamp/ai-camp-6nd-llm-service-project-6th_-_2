# ============================================================
# 반띵 환경 변수 예시
# 실제 값은 .env.local 등에 저장하고 절대 커밋하지 말 것
# ============================================================

# ---------- Supabase ----------
# 2024년 말부터 anon / service_role JWT는 레거시. 신규 키(sb_publishable_..., sb_secret_...) 사용.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...   # FastAPI 전용, 절대 클라이언트 노출 금지

# ---------- 카카오 ----------
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-js-key
KAKAO_REST_API_KEY=your-kakao-rest-key

# ---------- FastAPI ----------
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_INTERNAL_TOKEN=replace-with-strong-random-string

# ---------- Claude / Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- 네이버 CLOVA OCR ----------
CLOVA_OCR_SECRET=your-clova-secret
CLOVA_OCR_INVOKE_URL=https://...

# ---------- 카카오 알림톡 (비즈뿌리오 / 알리고) ----------
ALIMTALK_API_KEY=
ALIMTALK_SENDER_KEY=

# ---------- 결제 PG ----------
TOSS_SECRET_KEY=
PORTONE_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- 본인인증 (PASS / NICE) ----------
NICE_CLIENT_ID=
NICE_CLIENT_SECRET=

# ---------- 관측 ----------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
